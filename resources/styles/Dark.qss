/* ═══════════════════════════════════════════════════════════════════
   AEGIS Security — Ultra Dark Cyber Theme
   Pixel-Perfect Reproduction of AEGIS Design System
   ═══════════════════════════════════════════════════════════════════ */

QMainWindow, #centralWidget {
    background-color: #040B16;
    font-family: "Segoe UI", "Inter", "Nunito", -apple-system, sans-serif;
    font-size: 10pt;
    color: #F1F5F9;
    letter-spacing: 0.1px;
}

QWidget {
    font-family: "Segoe UI", "Inter", "Nunito", -apple-system, sans-serif;
    color: #F1F5F9;
}

/* ── Top Bar (ChromeBar) ── */
#ChromeBar {
    background-color: #050E1B;
    border-bottom: 1px solid #0D1E33;
    min-height: 48px;
    max-height: 48px;
}

#topSearchBar {
    background-color: rgba(18, 36, 60, 0.7);
    border: 1px solid rgba(40, 75, 120, 0.5);
    border-radius: 16px;
    padding: 5px 14px;
    color: #F1F5F9;
    font-size: 10pt;
    selection-background-color: #198FFD;
}
#topSearchBar:focus {
    border: 1px solid #198FFD;
    background-color: rgba(22, 44, 75, 0.9);
}

#btnTopBell {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}
#btnTopBell:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

#userProfileWidget {
    background-color: rgba(18, 36, 60, 0.5);
    border: 1px solid rgba(35, 65, 105, 0.4);
    border-radius: 18px;
    padding: 2px 8px;
}

#btnMinimize, #btnMaximize, #btnClose {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #94A3B8;
    font-size: 11pt;
    font-weight: bold;
}
#btnMinimize:hover, #btnMaximize:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
}
#btnClose:hover {
    background-color: #EF4444;
    color: #FFFFFF;
}

/* ── Left Sidebar ── */
#sidebar {
    background-color: #030812;
    border-right: 1px solid #0D1E33;
    min-width: 220px;
    max-width: 220px;
}

#lblAegisBrand {
    font-size: 14pt;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 1.2px;
}

#lblAegisTagline {
    font-size: 8.5pt;
    color: #7A92A8;
}

#lblSidebarFooter {
    font-size: 8pt;
    color: #4A6078;
    line-height: 12px;
}

#sidebar QPushButton {
    background-color: transparent;
    color: #8FA3BF;
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 8px;
    font-weight: 600;
    font-size: 10pt;
    margin: 2px 8px;
}
#sidebar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.04);
    color: #FFFFFF;
}
#sidebar QPushButton[active="true"] {
    background-color: rgba(14, 40, 65, 0.85);
    border-left: 3px solid #00F076;
    color: #FFFFFF;
    font-weight: 700;
}

/* ── Headings ── */
QLabel#pageTitle, QLabel#lblDashHeroTitle {
    font-size: 19pt;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 2px;
}
QLabel#pageSubtitle, QLabel#lblDashHeroSubtitle {
    font-size: 10pt;
    font-weight: 400;
    color: #8FA3BF;
    margin-bottom: 8px;
}

/* ── Glassmorphism Cards ── */
.glassCard, QFrame#cardHero, QFrame[class="glassCard"], QWidget[class="glassCard"] {
    background-color: rgba(11, 23, 39, 0.82);
    border: 1px solid rgba(28, 54, 88, 0.7);
    border-radius: 12px;
}
.glassCard:hover, QFrame[class="glassCard"]:hover {
    border: 1px solid rgba(56, 189, 248, 0.35);
}

/* ── Content Viewport & Backgrounds ── */
#viewportStack, #stackedWidget, #mainContentArea {
    background-image: url(:/assets/aegis_cyber_hud_bg.png);
    background-position: center;
    background-repeat: no-repeat;
}

/* Dashboard full mountain background & Hero */
#pageDashboard {
    background-color: #070e17;
}
#heroCardWithBg {
    background-color: transparent;
    border: none;
}

/* ── Scan Mode Selection Cards ── */
QFrame.scanModeCard, QFrame[class="scanModeCard"] {
    background-color: rgba(11, 23, 39, 0.85);
    border: 1px solid rgba(28, 54, 88, 0.7);
    border-radius: 12px;
}
QFrame.scanModeCard:hover {
    border: 1px solid rgba(25, 143, 253, 0.5);
    background-color: rgba(14, 30, 52, 0.9);
}
QFrame.scanModeCard[selected="true"] {
    border: 1.5px solid #198FFD;
    background-color: rgba(25, 143, 253, 0.12);
}

/* ── Buttons ── */
QPushButton {
    background-color: rgba(18, 36, 60, 0.8);
    border: 1px solid rgba(35, 65, 105, 0.6);
    border-radius: 8px;
    padding: 8px 18px;
    color: #F1F5F9;
    font-weight: 600;
    font-size: 10pt;
}
QPushButton:hover {
    background-color: rgba(28, 52, 85, 0.9);
    border-color: rgba(56, 189, 248, 0.5);
    color: #FFFFFF;
}
QPushButton:pressed {
    background-color: rgba(14, 28, 48, 0.9);
}

/* Neon Green Primary CTA */
QPushButton#btnQuickScanHero, QPushButton[class="btnNeonGreen"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00F076, stop:1 #00DF89);
    border: 1px solid #00F076;
    border-radius: 8px;
    color: #03180D;
    font-weight: 700;
    font-size: 10.5pt;
    padding: 10px 24px;
}
QPushButton#btnQuickScanHero:hover, QPushButton[class="btnNeonGreen"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #10FFA0, stop:1 #00F076);
    border-color: #10FFA0;
}

/* Vivid Blue CTA */
QPushButton#btnStartScanBig, QPushButton[class="btnVividBlue"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #198FFD, stop:1 #147CE5);
    border: 1px solid #198FFD;
    border-radius: 8px;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 10.5pt;
    padding: 11px 24px;
}
QPushButton#btnStartScanBig:hover, QPushButton[class="btnVividBlue"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #38BDF8, stop:1 #198FFD);
}

/* Dark Glassy Button (e.g. Więcej opcji, Pauza, Przywróć) */
QPushButton[class="btnDarkGlass"], QPushButton#btnMoreOptions, QPushButton#btnPauseScan {
    background-color: rgba(16, 32, 54, 0.75);
    border: 1px solid rgba(35, 65, 105, 0.7);
    border-radius: 8px;
    color: #E2E8F0;
    font-weight: 600;
    padding: 8px 18px;
}
QPushButton[class="btnDarkGlass"]:hover, QPushButton#btnMoreOptions:hover, QPushButton#btnPauseScan:hover {
    background-color: rgba(25, 48, 80, 0.85);
    border-color: rgba(56, 189, 248, 0.4);
    color: #FFFFFF;
}

/* Dark Danger Button (Zatrzymaj, Usuń) */
QPushButton[class="btnDangerDark"], QPushButton#btnStopScan, QPushButton#btnQuarantineDelete {
    background-color: #2D0F15;
    border: 1px solid #7F1D1D;
    border-radius: 8px;
    color: #F87171;
    font-weight: 600;
    padding: 8px 20px;
}
QPushButton[class="btnDangerDark"]:hover, QPushButton#btnStopScan:hover, QPushButton#btnQuarantineDelete:hover {
    background-color: #450A0A;
    border-color: #EF4444;
    color: #FFFFFF;
}

/* Small Action Button (Oczyść, Napraw, Zarządzaj, Zastosuj) */
QPushButton[class="btnActionSmall"] {
    background-color: rgba(18, 36, 60, 0.8);
    border: 1px solid rgba(35, 65, 105, 0.6);
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 9.5pt;
    font-weight: 600;
}
QPushButton[class="btnActionSmall"]:hover {
    background-color: rgba(28, 56, 92, 0.95);
    border-color: #198FFD;
    color: #FFFFFF;
}

/* ── Sub-Tabs (Navigation within pages) ── */
QPushButton[class="subTab"] {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #8FA3BF;
    font-size: 10pt;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 0px;
}
QPushButton[class="subTab"]:hover {
    color: #FFFFFF;
}
QPushButton[class="subTab"][active="true"] {
    color: #FFFFFF;
    border-bottom: 2px solid #00F076;
}

/* ── Toggle Switch (QCheckBox) ── */
QCheckBox[class="toggleSwitch"], QCheckBox.toggleSwitch {
    spacing: 10px;
    font-size: 10pt;
    color: #E2E8F0;
    font-weight: 600;
}
QCheckBox[class="toggleSwitch"]::indicator, QCheckBox.toggleSwitch::indicator {
    width: 44px;
    height: 24px;
    background: transparent;
    border: none;
    image: url(:/assets/icons/switch_off.svg);
}
QCheckBox[class="toggleSwitch"]::indicator:checked, QCheckBox.toggleSwitch::indicator:checked {
    background: transparent;
    border: none;
    image: url(:/assets/icons/switch_on.svg);
}

/* Standard CheckBox */
QCheckBox {
    spacing: 8px;
    color: #CBD5E1;
    font-size: 9.5pt;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #284466;
    border-radius: 4px;
    background-color: #0C1A2C;
}
QCheckBox::indicator:hover {
    border-color: #00F076;
}
QCheckBox::indicator:checked {
    background-color: #00F076;
    border-color: #00F076;
    image: url(:/assets/icons/icon_check.svg);
}

/* ── Tables & Lists ── */
QTableWidget, QTableView {
    background-color: rgba(10, 24, 42, 0.75);
    border: 1px solid rgba(28, 54, 88, 0.55);
    border-radius: 12px;
    gridline-color: transparent;
    color: #E2E8F0;
    font-size: 9.5pt;
    selection-background-color: rgba(0, 240, 118, 0.12);
    selection-color: #FFFFFF;
    outline: none;
}
QHeaderView {
    background-color: transparent;
    border: none;
}
QHeaderView::section {
    background-color: rgba(14, 28, 48, 0.95);
    color: #8FA3BF;
    font-size: 8.5pt;
    font-weight: 700;
    text-transform: uppercase;
    border: none;
    border-bottom: 1px solid rgba(28, 54, 88, 0.7);
    padding: 9px 12px;
}
QTableCornerButton::section {
    background-color: rgba(14, 28, 48, 0.95);
    border: none;
}
QTableWidget::item {
    padding: 8px 10px;
    border-bottom: 1px solid rgba(25, 48, 78, 0.3);
}

/* ── Input Fields & ComboBoxes ── */
QLineEdit, QComboBox {
    background-color: rgba(14, 28, 48, 0.85);
    border: 1px solid rgba(28, 54, 88, 0.8);
    border-radius: 8px;
    padding: 8px 12px;
    color: #F1F5F9;
    font-size: 10pt;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #198FFD;
    background-color: rgba(18, 36, 62, 0.95);
}
QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}
QComboBox QAbstractItemView {
    background-color: #0D1D32;
    border: 1px solid #1E3A5F;
    border-radius: 8px;
    color: #F1F5F9;
    selection-background-color: #198FFD;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgba(40, 75, 120, 0.4);
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(56, 189, 248, 0.6);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ── Status Badges ── */
.badgeAllowed {
    color: #00F076;
    font-weight: 600;
}
.badgeBlocked {
    color: #EF4444;
    font-weight: 600;
}
.badgeActive {
    color: #00F076;
    font-weight: 600;
    font-size: 9pt;
}
